{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "council",
  "model": "opencode-go/glm-5.1",
  "small_model": "opencode-go/glm-5.2",
  "enabled_providers": [
    "opencode-go",
    "openai",
    "opencode"
  ],
  "share": "manual",
  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      ".git/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/runs/**",
      "**/.ipynb_checkpoints/**"
    ]
  },
  "agent": {
    "council": {
      "description": "DeepSeek V4 Flash-led control council spokesperson. Delegates repo work to workers, requires DeepSeek V4 Pro, GPT-5.5 and Kimi K2.6 review, and is the only user-facing agent.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "color": "primary",
      "steps": 24,
      "prompt": "{file:./.opencode/prompts/council.md}",
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "council-*": "allow"
        },
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "worker-kimi": "allow",
          "worker-minimax": "allow",
          "worker-deepseek": "allow",
          "council-planner": "allow",
          "council-review-glm": "allow",
          "council-review-gpt5x": "allow",
          "council-review-deepseek": "allow",
          "council-review-kimi": "allow",
          "council-vision": "allow",
          "council-ideator": "allow",
          "council-impl-refiner": "allow"
        }
      }
    },
    "worker-kimi": {
      "description": "Focused implementation worker using Kimi K2.6 for normal coding, file reading, and targeted edits.",
